<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yong.mapper.CourseMapper">
    <!-- 查询 -->
    <select id="list" resultType="com.yong.pojo.Course">
        select c.* from course c
        <where>
            <if test="name != null and name !=''">c.name like concat('%',#{name},'%')</if>
            <if test="creditsMin != null and creditsMax != null">and c.credits between #{creditsMin} and #{creditsMax}</if>
        </where>
        order by c.update_time desc
    </select>

    <!-- 删除对应id的课程数据 -->
    <delete id="delete">
        delete from course where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 返回课程查询下拉列表 -->
    <select id="getCourseIdOptions">
        SELECT
            name AS label,
            id   AS value
        FROM course
        ORDER BY id ASC
    </select>
</mapper>